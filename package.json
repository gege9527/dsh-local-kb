{
  "name": "dsh-local-kb",
  "version": "0.6.3",
  "description": "知识库 + 长期记忆插件：每轮注入记忆索引与知识地图、索引硬上限、禁止 AI 删除、镜像同步到 WebDAV",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "knowledge-base",
    "local-kb",
    "memory",
    "webdav",
    "sync"
  ],
  "type": "module",
  "main": "index.js",
  "author": "lyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gege9527/dsh-local-kb.git"
  },
  "homepage": "https://github.com/gege9527/dsh-local-kb#readme",
  "bugs": {
    "url": "https://github.com/gege9527/dsh-local-kb/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "remote",
        "remote.credentials"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.0 <0.3.0-0",
      "dshReleases": {
        "0.2.2-alpha.2": "compatible"
      }
    }
  },
  "exports": {
    ".": "./index.js",
    "./inject": "./inject.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "inject.js",
    "install-skill.js",
    "migrate.js",
    "client.js",
    "skills/local-kb/SKILL.md",
    "skills/local-kb/references/",
    "skills/local-kb/tools/*.py",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node tests/skill-content.spec.mjs && node tests/tools.spec.mjs && node tests/add-project.spec.mjs && node tests/archive-project.spec.mjs && node tests/archive-note.spec.mjs && node tests/privacy.spec.mjs && node tests/card-quality.spec.mjs && node tests/kb-check.spec.mjs && node tests/kb-move.spec.mjs && node tests/gate.spec.mjs && node tests/api.spec.mjs && node tests/path.spec.mjs && node tests/bash.spec.mjs && node tests/code-write.spec.mjs && node tests/index-cap.spec.mjs && node tests/delete-guard.spec.mjs && node tests/inject.spec.mjs && node tests/mirror.spec.mjs && node tests/reminder.spec.mjs && node tests/settings.spec.mjs && node tests/uninstall.spec.mjs && node tests/migrate.spec.mjs && node tests/hit-rate.spec.mjs && node scripts/check-package.mjs",
    "test:skill": "node tests/skill-content.spec.mjs",
    "test:tools": "node tests/tools.spec.mjs",
    "test:kb-check": "node tests/kb-check.spec.mjs",
    "test:gate": "node tests/gate.spec.mjs",
    "test:api": "node tests/api.spec.mjs",
    "test:path": "node tests/path.spec.mjs",
    "test:bash": "node tests/bash.spec.mjs",
    "test:code-write": "node tests/code-write.spec.mjs",
    "test:index-cap": "node tests/index-cap.spec.mjs",
    "test:delete": "node tests/delete-guard.spec.mjs",
    "test:inject": "node tests/inject.spec.mjs",
    "test:mirror": "node tests/mirror.spec.mjs",
    "test:reminder": "node tests/reminder.spec.mjs",
    "test:settings": "node tests/settings.spec.mjs",
    "test:uninstall": "node tests/uninstall.spec.mjs",
    "test:hit": "node tests/hit-rate.spec.mjs",
    "test:card-quality": "node tests/card-quality.spec.mjs",
    "test:hit-real": "node tests/hit-rate-real.mjs",
    "test:add": "node tests/add-project.spec.mjs",
    "test:archive": "node tests/archive-project.spec.mjs && node tests/archive-note.spec.mjs",
    "test:migrate": "node tests/migrate.spec.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "node scripts/check-package.mjs && node scripts/check-privacy.mjs",
    "check:privacy": "node scripts/check-privacy.mjs"
  }
}
